# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# OS / Editor artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Python Virtual Environments
venv/
.venv/
env/
*.env

# Binary artifacts / serialization caches
*.pkl

# Large external logs (>2.5GB)
data/ait_ads/

# Raw sightings CSV (large; keep local, do not track)
data/sightings_v2_public.csv

# Research paper reference PDFs (contains 120MB PDF exceeding GitHub limits)
Researach Papers/

# CPTC-2018 Suricata alerts (external, 42MB; fetch from tudelft-cda-lab/SAGE)
data/cptc_2018/

# Serving model binaries (derived; rebuild with python src/serve/artifacts.py)
artifacts/*.joblib

# Frontend build output and dependencies
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo
